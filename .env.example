# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Swap to claude-sonnet-5 or claude-opus-5 for slower/pricier but stronger runs.
ANTHROPIC_MODEL=claude-haiku-4-5

# Django
DJANGO_SECRET_KEY=change-me-in-a-real-deployment
DJANGO_DEBUG=true

# Postgres (also used to build the web service's DATABASE_URL)
POSTGRES_DB=orchai
POSTGRES_USER=orchai
POSTGRES_PASSWORD=orchai
POSTGRES_HOST=db
POSTGRES_PORT=5432
